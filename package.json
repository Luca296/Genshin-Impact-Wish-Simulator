{
  "name": "genshin-wish-offline",
  "description": "Realistic Genshin Impact Wish Simulator, Unlimited Gacha, 100% running on browser",
  "version": "1.5.0",
  "author": {
    "name": "AguzzTN54",
    "email": "admin@wishsimulator.app",
    "url": "https://github.com/AguzzTN54"
  },
  "repository": {
    "url": "https://github.com/AguzzTN54/Genshin-Impact-Wish-Simulator"
  },
  "license": "MIT",
  "homepage": "https://wishsimulator.app",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "format": "prettier --plugin-search-dir . --write .",
    "desktop": "electron .",
    "package": "npm run build && electron-builder --win dir",
    "test": "node --test tests/*.test.cjs"
  },
  "type": "module",
  "devDependencies": {
    "@sveltejs/adapter-static": "2.0.3",
    "@sveltejs/kit": "1.30.4",
    "@sveltejs/vite-plugin-svelte": "2.5.3",
    "autoprefixer": "^10.4.8",
    "dotenv": "^16.3.1",
    "electron": "39.8.3",
    "electron-builder": "26.0.12",
    "eslint": "^8.16.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-svelte3": "^4.0.0",
    "fake-indexeddb": "^6.2.4",
    "marked": "12.0.2",
    "playwright": "^1.56.1",
    "postcss": "^8.4.16",
    "postcss-load-config": "^4.0.1",
    "postcss-nested": "^5.0.6",
    "prettier": "^2.6.2",
    "prettier-plugin-svelte": "^2.7.0",
    "svelte": "3.59.2",
    "svelte-check": "^2.9.2",
    "svelte-preprocess": "^4.10.6",
    "uuid": "^9.0.0",
    "vite": "4.5.14",
    "file-saver": "^2.0.5",
    "hotkeys-js": "^3.12.0",
    "howler": "^2.2.3",
    "html-to-image": "^1.8.5",
    "idb": "^6.1.2",
    "overlayscrollbars": "^1.13.1",
    "svelte-i18n": "^3.4.0",
    "zoomist": "^2.0.10"
  },
  "dependencies": {},
  "main": "electron/main.cjs",
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "local.genshinwish.offline",
    "productName": "Genshin Wish Offline",
    "directories": {
      "output": "../outputs/desktop-1.5.0"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "COMBAT-DATA-LICENSE.txt"
    ],
    "asar": true,
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "electronLanguages": [
      "en-US",
      "de",
      "es",
      "fr",
      "id",
      "it",
      "ja",
      "ko",
      "pt-BR",
      "ru",
      "th",
      "tr",
      "vi",
      "zh-CN",
      "zh-TW"
    ]
  }
}
